# Copie este arquivo para ".env" e ajuste os valores.

# Chave secreta da sessão. Gere uma com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Deixe comentado para usar SQLite local (instance/acesso_plus.db).
# DATABASE_URL=postgresql+psycopg://postgres:senha@localhost:5432/acesso_plus

# Use 1 quando o site estiver rodando em HTTPS
COOKIE_SECURE=0
